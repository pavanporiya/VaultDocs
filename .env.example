# =============================================================================
# VaultDocs Environment Configuration
# =============================================================================
# Copy this file:
#
#   cp .env.example .env
#
# Then update the values below before running the application.
#
# =============================================================================


# =============================================================================
# Application
# =============================================================================

APP_NAME=VaultDocs
APP_ENV=development
DEBUG=true
APP_PORT=8000


# =============================================================================
# Security
# =============================================================================
# Generate a secure key:
#
# python -c "import secrets; print(secrets.token_urlsafe(32))"
#

SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=30


# =============================================================================
# Database
# =============================================================================

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=VaultDocs
DATABASE_USER=VaultDocs_user
DATABASE_PASSWORD=change-me-in-production

DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}


# =============================================================================
# Logging
# =============================================================================

LOG_LEVEL=INFO


# =============================================================================
# CORS
# =============================================================================

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# =============================================================================
# File Upload
# =============================================================================

STORAGE_DIR=var/storage

MAX_UPLOAD_SIZE=26214400


# =============================================================================
# Email & Verification (Gmail SMTP / OTP)
# =============================================================================
# Use a 16-character Google App Password (not your normal Gmail password).
# Setup: Google Account -> Security -> 2-Step Verification -> App passwords.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=VaultDocs
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# OTP Verification Controls
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_FAILED_ATTEMPTS=5


# =============================================================================
# Sign-In Device Approval / Web Push (optional)
# =============================================================================
# When both keys are set, new-device sign-ins send a Web Push approval
# prompt to registered trusted phones ("Are you trying to sign in to
# VaultDocs?"). When unset, the secure email approval-code fallback is
# used instead — approval is never bypassed.
#
# Web Push requires HTTPS (or localhost). Generate a key pair with:
#
# python -c "import base64; from py_vapid import Vapid02; from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat; v = Vapid02(); v.generate_keys(); print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)).decode().rstrip('=')); print('VAPID_PRIVATE_KEY=' + base64.urlsafe_b64encode(v.private_key.private_numbers().private_value.to_bytes(32, 'big')).decode().rstrip('='))"
#
# VAPID_PRIVATE_KEY is a secret. Never commit the real .env.

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=admin@vaultdocs.local

# Trusted-device / challenge tuning (safe defaults shown)
# LOGIN_CHALLENGE_EXPIRE_SECONDS=300
# TRUSTED_DEVICE_EXPIRE_DAYS=30
# PUSH_SUBSCRIPTION_EXPIRE_DAYS=60
# LOGIN_APPROVAL_CODE_EXPIRE_MINUTES=10
# LOGIN_APPROVAL_CODE_MAX_FAILED_ATTEMPTS=5
# LOGIN_APPROVAL_CODE_COOLDOWN_SECONDS=60


# =============================================================================
# Docker
# =============================================================================
# Docker Compose automatically overrides DATABASE_HOST=db
# No changes are required when using docker-compose.
# =============================================================================
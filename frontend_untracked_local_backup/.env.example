# Frontend environment template
# Copy to .env.local for local overrides. Never put secrets here —
# everything in VITE_* is embedded into the client bundle and public.

# Base URL of the VaultDocs API.
# Leave empty for development: the Vite dev server proxies /v1 to
# http://localhost:8000 (see vite.config.ts).
VITE_API_BASE_URL=
